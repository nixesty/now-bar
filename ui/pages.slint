            }
        }
    }
}

// ================================================================== 10 Dijital Denge

export component WellbeingBody inherits VerticalLayout {
    alignment: start;
    H4 {
        title: @tr("Bugün");
        count: Store.usage-total;
    }
    if Store.usage-apps.length == 0: LRow {
        title: @tr("Henüz ekran süresi yok");
        sub: Store.wellbeing-on ? @tr("uygulamalar öndeyken sayılır") : @tr("kapalı");
        lead: 1;
        glyph: "\u{E95E}";
    }
    for a in Store.usage-apps: Rectangle {
        height: 54px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 7px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: a.name;
                        font-size: 14px;
                        font-weight: 500;
                        color: Theme.strong;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: a.time;
                        font-size: 13px;
                        color: Theme.text2;
                        horizontal-stretch: 0;
                    }
                }
                // Its share of the longest app's time, in Dijital Denge's green.
                Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.field;
                    Rectangle {
                        x: 0px;
                        width: max(3px, parent.width * a.share);
                        border-radius: 1.5px;
                        background: #2FB37E;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Select {
                    options: [@tr("Sınır yok"), @tr("30 dk"), @tr("1 sa"), @tr("2 sa"), @tr("3 sa"), @tr("4 sa")];
                    selected: a.limit;
                    box-width: 112px;
                    picked(i) => { Store.limit-set(a.exe, i); }
                }
            }
        }
    }
    Tail { }
}

export component WellbeingInspector inherits VerticalLayout {
    alignment: start;
    ISection {
        title: @tr("Dijital Denge");
        first: true;
        IRow {
            label: @tr("Ekran süresini say");
            note: @tr("Bu bilgisayarda kalır, bir hafta");
            Toggle {
                checked <=> Store.wellbeing-on;
                toggled => { Ui.changed(); }
            }
        }
        IRow {
            opacity: Store.wellbeing-on ? 1 : 0.4;
            label: @tr("Now Brief'te göster");
            note: @tr("Dünün ya da bugünün toplamı");
            Toggle {
                checked <=> Store.wellbeing-in-brief;
                toggled => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Sınırlar");
        IRow {
            opacity: Store.wellbeing-on ? 1 : 0.4;
            label: @tr("Sınır uyarıları");
            note: @tr("Sınırı geçince pilde bir an");
            Toggle {
                checked <=> Store.wellbeing-limit-moments;
                toggled => { Ui.changed(); }
            }
        }
    }
    ISection {
        title: @tr("Müzik");
        IRow {
            label: @tr("Haftanın müziği");
            note: @tr("Çalanlar bu bilgisayarda sayılır");
            Toggle {
                checked <=> Store.music-week;
                toggled => { Ui.changed(); }
            }
        }
    }
}
